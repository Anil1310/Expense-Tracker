{
  "buildCommand": "node scripts/build.mjs",
  "outputDirectory": "dist",
  "functions": {
    "api/apps-script.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/apps-script",
      "destination": "/api/apps-script"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
